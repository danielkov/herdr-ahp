{
  "protocolVersion": "draft",
  "hooks": [
    {
      "id": "com.github.danielkov.herdr-ahp",
      "transport": {
        "type": "stdio",
        "command": "herdr-ahp",
        "lifecycle": "persistent"
      },
      "subscriptions": [
        {
          "events": [
            "session.start",
            "turn.start",
            "turn.end"
          ],
          "mode": "observe",
          "content": {
            "default": "metadata"
          }
        }
      ]
    }
  ]
}
